            <div className="flex items-center gap-1.5">
              <span className="text-base sm:text-lg font-extrabold tracking-tight text-slate-900 truncate">
                {t.appName}
              </span>
              {isLedgerEncrypted && (
                <span
                  title={t.encryptedAesBadge}
