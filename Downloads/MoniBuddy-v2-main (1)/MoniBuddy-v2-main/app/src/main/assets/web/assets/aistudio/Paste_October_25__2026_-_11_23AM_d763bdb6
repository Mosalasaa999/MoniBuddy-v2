  );

  const formatZAR = (val: number) =>
    `R ${val.toLocaleString('en-ZA', {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    })}`;

  const handleQuickDeposit = (amount: number) => {
    setQuickSaveError(null);
